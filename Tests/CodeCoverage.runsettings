<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings for Microsoft's code coverage collector, shared by all test targets:
  the Microsoft.Testing.Platform ones pass it through the coverage-settings option, the VSTest based ones
  through the settings option.

  The collector excludes types annotated with [DebuggerNonUserCode] by default. That attribute is used
  throughout AwesomeAssertions to keep the debugger from stepping into the assertion classes, so the default
  would leave most of the public API unmeasured. mergeDefaults="False" replaces the built-in list for this
  section instead of adding to it, which lets us drop that one entry and keep the rest.

  Only the Attributes section is affected; the built-in ModulePaths, Functions and Sources lists stay in force.
  See https://github.com/microsoft/codecoverage/blob/main/docs/configuration.md
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <Attributes mergeDefaults="False">
              <Exclude>
                <Attribute>^System\.Diagnostics\.DebuggerHiddenAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
                <Attribute>^Microsoft\.VisualStudio\.TestPlatform\.TestSDKAutoGeneratedCode$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
