<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DebugType>full</DebugType>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No coverage is collected for this project, see the comment on Build.CollectsCoverage. In short: the
      assembly level [AssertionEngineInitializer] attribute in AssertionEngineInitializer.cs is defined in
      AwesomeAssertions, so the test host controller loads AwesomeAssertions.dll before instrumentation
      starts, and coverlet cannot rewrite a loaded assembly.
    -->
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\AwesomeAssertions\AwesomeAssertions.csproj" />
  </ItemGroup>

</Project>
