<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <!-- "Field is never used" - by design in Fallout -->
    <NoWarn>$(NoWarn);CS0169</NoWarn>
    <!-- "Field is never assigned" - by design in Fallout -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <FalloutRootDirectory>..\</FalloutRootDirectory>
    <FalloutScriptDirectory>..\</FalloutScriptDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="GitVersion.Tool" Version="[6.5.1]" />
    <PackageDownload Include="ReportGenerator" Version="[5.5.11]" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
    <PackageReference Include="Fallout.Components" Version="10.4.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
</Project>
